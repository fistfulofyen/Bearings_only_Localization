# BEAR.DEF -- default inputs for BEAR (bearings-only target localization)
#
# Units: metres, seconds, radians.  Vectors: comma-separated numbers.
# '#' or ';' starts a comment.  Every section whose name starts with
# "maneuver" defines one platform maneuver leg; delete them all for a
# non-maneuvering (unobservable) platform.

[target]
# A1: true target parameter at t = 0:  xi0, eta0, xi_dot, eta_dot
x_true = 5000, 12000, -6, -2

[sampling]
# A2: sampling period T (s)
T = 10
# A3: number of samples n; measurements are taken at t_k = k T, k = 1..n
n = 60

[noise]
# A4: bearing measurement noise variance r (rad^2); (1 deg)^2 = 3.0462e-4
r = 0.0003046174198
# random seed for the measurement noise (leave blank for a random seed)
seed = 1

[platform]
# A5: platform initial position (m) and velocity (m/s)
position = 0, 0
velocity = 0, 15

[maneuver 1]
# A6: platform velocity (m/s) in effect for k1*T <= t < k2*T;
#     outside all legs the platform moves with its initial velocity
velocity = 15, 0
k1 = 20
k2 = 40

[estimation]
# A7: initial estimate of the parameter:  xi0, eta0, xi_dot, eta_dot
x_init = 2000, 8000, 0, 0
# minimization method: gauss-newton (Levenberg-Marquardt) or bfgs (quasi-Newton)
method = gauss-newton
max_iter = 200
# convergence tolerance (Gauss-Newton decrement / BFGS gradient norm)
tol = 1e-10

[statistics]
# probability of the two-sided chi-square acceptance intervals (B7, B8)
confidence = 0.95
